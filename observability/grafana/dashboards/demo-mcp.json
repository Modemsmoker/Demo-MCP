{
  "title": "Demo-MCP",
  "uid": "demo-mcp",
  "editable": true,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Tool call rate by tool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (tool) (rate(demo_mcp_tool_calls_total[5m]))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Tool call error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (tool) (rate(demo_mcp_tool_calls_total{status=\"error\"}[5m]))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 tool call duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(demo_mcp_tool_call_duration_seconds_bucket[5m])))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Outbound HTTP request rate by host/status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (host, status) (rate(demo_mcp_http_requests_total[5m]))",
          "legendFormat": "{{host}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "p95 outbound HTTP duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, host) (rate(demo_mcp_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{host}}"
        }
      ]
    }
  ]
}
