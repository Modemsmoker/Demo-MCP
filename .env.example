MCP_AUTH_TOKEN=replace-me

# Optional. A GitHub personal access token the server uses when calling the
# GitHub API on your behalf. Without it, GitHub tools still work but are
# limited to the unauthenticated rate limit (60 requests/hour).
GH_API_TOKEN=

# Optional. Admin password for the Grafana container started by
# `docker-compose.yml`. Anonymous Viewer access is enabled locally, so this
# is only needed to log in and edit dashboards. Defaults to "admin".
GRAFANA_ADMIN_PASSWORD=admin
